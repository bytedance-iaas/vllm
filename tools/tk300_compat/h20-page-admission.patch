+    def _prefill_request_snapshot(self, request: Request) -> dict[str, Any]:
+        confirmed = min(
+            request.num_prompt_tokens,
+            max(
+                0,
+                request.num_computed_tokens
+                - max(request.num_in_flight_tokens, request.num_output_placeholders),
+            ),
+        )
+        return {
+            "request_id": request.external_req_id,
+            "internal_request_id": request.request_id,
+            "bucket": _admission_bucket(request),
+            "input_tokens": request.num_prompt_tokens,
+            "cached_tokens": getattr(request, "prefill_cached_tokens", 0),
+            "confirmed_tokens": confirmed,
+            "in_flight_tokens": request.num_in_flight_tokens,
+            "remaining_tokens": max(0, request.num_prompt_tokens - confirmed),
+            "status": request.status.name,
+            "terminal": request.is_finished(),
+            "drained": False,
+        }
+
+
+    def get_prefill_progress(self, request_ids: list[str]) -> dict[str, Any]:
+        """A bounded CPU snapshot; unknown requests never imply an idle engine."""
+        if not _admission_progress_enabled():
+            raise RuntimeError("Prefill progress is disabled")
+        if len(request_ids) > 128:
+            raise ValueError("At most 128 request IDs may be queried")
+        self.prefill_progress_seq += 1
+        snapshots: list[dict[str, Any]] = []
+        for request_id in request_ids:
+            internal_ids = self.prefill_external_ids.get(request_id)
+            if internal_ids:
+                snapshots.extend(
+                    self._prefill_request_snapshot(self.requests[internal_id])
+                    for internal_id in sorted(internal_ids)
+                )
+            elif request_id in self.prefill_terminal:
+                snapshot = dict(self.prefill_terminal[request_id])
+                fence = snapshot.pop("release_fence")
+                completion_fence = snapshot.pop("completion_fence")
+                snapshot["drained"] = (
+                    completion_fence <= self.prefill_processed_step_seq
+                    and (not self.defer_block_free or fence <= self.processed_step_seq)
+                )
+                if snapshot["drained"]:
+                    snapshot["in_flight_tokens"] = 0
+                snapshots.append(snapshot)
+            else:
+                snapshots.append({"request_id": request_id, "status": "UNKNOWN"})
+        queues = {
+            bucket: {"waiting": 0, "running": 0}
+            for bucket in ("short", "medium", "long", "very_long")
+        }
+        for request in self.requests.values():
+            if request.is_finished() or request.num_output_tokens:
+                continue
+            state = "running" if request.status == RequestStatus.RUNNING else "waiting"
+            queues[_admission_bucket(request)][state] += 1
+        return {
+            "schema_version": 1,
+            "epoch": self.prefill_progress_epoch,
+            "dp_rank": self.parallel_config.data_parallel_rank,
+            "seq": self.prefill_progress_seq,
+            "scheduler_step": self.current_step,
+            "scheduled_step_seq": self.prefill_scheduled_step_seq,
+            "processed_step_seq": self.prefill_processed_step_seq,
+            "requests": snapshots,
+            "queues": queues,
+            "free_kv_blocks": self.kv_cache_manager.block_pool.get_num_free_blocks(),
+            "shared_ep_budget": getattr(self, "shared_ep_observation", {}),
+            "shared_ep_fallbacks": dict(getattr(self, "shared_ep_fallbacks", {})),
+        }
+
+
+    def get_decode_capacity(
+        self,
+        request_ids_by_rank: dict[int, list[str]],
+        close_ids_by_rank: dict[int, list[str]] | None = None,
+        expected_epochs: dict[int, str] | None = None,
+    ) -> dict[str, Any]:
+        """Join allocations and free pages without interleaving scheduler work."""
+        rank = self.parallel_config.data_parallel_rank
+        request_ids = request_ids_by_rank.get(rank, [])
+        close_ids = (close_ids_by_rank or {}).get(rank, [])
+        if (
+            len(request_ids_by_rank) > 64
+            or len(request_ids) > 128
+            or len(close_ids) > 128
+        ):
+            raise ValueError("Capacity queries are limited to 128 IDs per rank")
+        if not _admission_progress_enabled():
+            raise RuntimeError("Request progress is disabled")
+        closed = []
+        refused = []
+        if (expected_epochs or {}).get(rank) == self.prefill_progress_epoch:
+            for external_id in close_ids:
+                if (
+                    external_id not in self.decode_admission_closed
+                    and len(self.decode_admission_closed) >= 4096
+                ):
+                    refused.append(external_id)
+                    continue
+                self.decode_admission_closed.add(external_id)
+                self.finish_requests(
+                    self.prefill_external_ids.get(external_id, ()),
+                    RequestStatus.FINISHED_ABORTED,
+                )
+                closed.append(external_id)
+        snapshot = self.get_prefill_progress(request_ids)
+        pool = self.kv_cache_manager.block_pool
+        for record in snapshot["requests"]:
+            if record["status"] == "UNKNOWN":
+                record["allocated_pages"] = None
+            elif record.get("internal_request_id") not in self.requests:
+                # Retained terminal records are created after block release.
+                record["allocated_pages"] = 0
+            else:
+                blocks = self.kv_cache_manager.get_blocks(record["internal_request_id"])
+                record["allocated_pages"] = len(
+                    {
+                        block.block_id
+                        for group in blocks.blocks
+                        for block in group
+                        if not block.is_null and block.ref_cnt > 0
+                    }
+                )
+        queried = set(request_ids)
+        snapshot.update(
+            capacity_schema_version=1,
+            closed_request_ids=closed,
+            refused_close_ids=refused,
+            total_kv_blocks=pool.num_gpu_blocks,
+            group_block_sizes=[
+                group.kv_cache_spec.block_size
+                for group in self.kv_cache_manager.kv_cache_config.kv_cache_groups
+            ],
+            unmanaged_requests=sum(
+                not request.is_finished() and request.external_req_id not in queried
+                for request in self.requests.values()
+            ),
+        )
+        return snapshot
+
