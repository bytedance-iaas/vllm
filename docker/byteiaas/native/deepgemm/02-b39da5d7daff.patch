+                        ? __tanhf(gate / kSiTUBeta)
+                        : tanhf(gate / kSiTUBeta);
+                    const float up_tanh = kFastMath
+                        ? __tanhf(up / kSiTULinearBeta)
+                        : tanhf(up / kSiTULinearBeta);
