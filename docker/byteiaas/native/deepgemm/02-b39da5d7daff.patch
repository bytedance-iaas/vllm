+    constexpr uint32_t kSwizzleAMode   = BLOCK_K * sizeof(a_dtype_t);   // 128
+    // The decoded E4M3 B tile uses 128B swizzle to match the SS WGMMA
+    // descriptor. The packed FP4 source tile is linear in the default
