+    constexpr uint32_t SMEM_CD_SWAP_L1_FP8_SIZE =
+        kSwapABL1Active ? BLOCK_M * L1_OUT_BLOCK_N * sizeof(cutlass::float_e4m3_t) : 0;
+    constexpr uint32_t SMEM_CD_SWAP_L1_SIZE =
