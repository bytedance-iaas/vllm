+                }
+            }
+            };
+
+            // Per-tile dispatch of the specialized K-stage loop. `n_swap` and
+            // the phase are tile constants, so decide them once here instead
+            // of on every K-stage inside the loop.
+            if constexpr (kSwapABL1Active) {
