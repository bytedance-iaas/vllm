+#ifdef DG_MEGA_MOE_FP4_N64_DECODE_READY
+    constexpr uint32_t kDecodeReadyGroups = 2;
+    DG_STATIC_ASSERT(BLOCK_M == 64 and LOAD_BLOCK_N == 128 and
