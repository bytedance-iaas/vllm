+                                final_accum[i*4+1] += scale_a_0_lo * accum[i*4+1];
+                                final_accum[i*4+2] += scale_a_1_lo * accum[i*4+2];
+                                final_accum[i*4+3] += scale_a_1_lo * accum[i*4+3];
