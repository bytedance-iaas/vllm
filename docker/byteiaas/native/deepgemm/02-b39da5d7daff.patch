+        L1_SHAPE_N, L1_SHAPE_K,
+        L2_SHAPE_N, L2_SHAPE_K,
+        kNumExpertsPerRank, kNumExpertsPerWave,
+        kNumSMs, kNumRanks,
+        kNumExpertsPerLane, kNumL1BlockNs, kNumL2BlockNs,
+        kNumL1BlockKs, kNumL2BlockKs,
