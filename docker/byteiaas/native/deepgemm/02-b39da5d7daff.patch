+    constexpr uint32_t kNumL2BlockNs = L2_SHAPE_N / BLOCK_N;
+    constexpr uint32_t kNumL1BlockKs = L1_SHAPE_K / BLOCK_K;
+    constexpr uint32_t kNumL2BlockKs = L2_SHAPE_K / BLOCK_K;
