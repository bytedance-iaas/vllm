From 997a2e586d2adafe7d984c543f48d00436daea0a Mon Sep 17 00:00:00 2001
From: wangyicong <wangyicong@bytedance.com>
Date: Fri, 30 Oct 2026 12:25:39 +0800
Subject: [PATCH] perf(dsv41): use ordered Humming dense exact shapes

Port to vLLM v0.32.0 (5df63a7203cdb9328d824a27b682e77c7b9928be).
Original optimization: 9f2271588e57434ea93d3e9ceb7e13b644f79250 (audit #42).
Forward-port ordered Decode Stream-K reduction to latest upstream Humming f970d0b using native configurable stream_k_max_slices=3. Preserve default10, current packed-scale/stage/multicast alignment, and existing upstream WGMMA issue/wait. vLLM exact-shape integration is a following independent commit.
Performance and validation claims in the original description below
refer to the original environment; they are not new release validation.

Original commit description and attribution:

Enable the isolated Humming 0.1.12 dense path, make fused MLP dispatch yield to it, retain the legacy WQ_B isolation guard, and cover residual plus exact target M108/draft M90 shapes. Exclude the rejected W8A8-only WQ_B and M96-BF16 experiments.

Round137 M96/M80 evidence versus RS76/on: Output TPS +8.60%, Mean TPOT -8.68%, P99 TPOT -7.86%, AIME26 96.25%, and GSM8K 97.0%. Separately, M108/M90 reduced Marlin from 22.689 to 0.183 ms/cycle and reached a 52.529 ms Decode cycle, 1.85% behind SGLang; M108/M90 has operator and service evidence but no full AIME/GSM qualification.

Co-authored-by: TRAE (GPT-6) <traecli@bytedance.com>
Signed-off-by: trae-solo-agent <solo-agent@trae.ai>
---
 docs/dsv41-unified-serving.md         | 23 +++++++++++++++++++++++
 humming/config/config.py              |  3 +++
 humming/include/humming/scheduler.cuh |  6 +++++-
 3 files changed, 31 insertions(+), 1 deletion(-)
 create mode 100644 docs/dsv41-unified-serving.md

diff --git a/docs/dsv41-unified-serving.md b/docs/dsv41-unified-serving.md
new file mode 100644
index 0000000000000000000000000000000000000000..82300ceeddb45cbaf2162c8c4145842739146150
--- /dev/null
+++ b/docs/dsv41-unified-serving.md
@@ -0,0 +1,23 @@
+# DeepSeek V4.1 unified serving additions
+
+The serving fork starts at upstream
+`f970d0b3a97c59481436a542ed8c0d73a731ace5`. Prefill and Decode use the same
+package, without restoring the old Prefill vendor or Decode 0.1.12 package.
+
+Selected Decode FP8 projections set `stream_k_max_slices=3` in their tuning
+configuration, with `use_tma_c=False`. The scheduler accounts for a partial
+first slice when enforcing the limit. This retains the ordered BF16 reduction
+path in `GmemWriter::write_legacy`; other callers keep the upstream ten-slice
+limit. The limit is part of the JIT configuration and kernel cache identity.
+
+The original optimization is vLLM
+`9f2271588e57434ea93d3e9ceb7e13b644f79250`, which used a Python partition check
+against Humming 0.1.12. Current callers must use the native limit instead of
+assuming that the old scheduler formula still describes upstream scheduling.
+
+The upstream WGMMA split issue/wait and late scale prefetch code is retained.
+Prefill W13 tuning should enable those native fields rather than replacing
+the consumer pipeline with the old vendored implementation.
+
+Original performance claims require new numerical and serving validation on
+the unified package.
diff --git a/humming/config/config.py b/humming/config/config.py
index ed5bdc916a3f37cb78108bed9a878165669d615b..9097443d282c40e2bf2e6639bf32246ac693dd74 100644
--- a/humming/config/config.py
+++ b/humming/config/config.py
@@ -531,6 +531,7 @@ class TuningConfig(BaseHummingConfig):
     warp_shape: tuple[int, int, int]
 
     use_stream_k: bool = True
+    stream_k_max_slices: int = 10
 
     wgmma_use_late_as: bool = False
     wgmma_split_issue_wait: bool = False
@@ -618,6 +619,8 @@ class TuningConfig(BaseHummingConfig):
                 self.smem_reuse_mode = SmemReuseMode.NONE
         self.smem_reuse_mode = SmemReuseMode(self.smem_reuse_mode)
         assert self.block_shape[0] <= 256
+        if type(self.stream_k_max_slices) is not int or not 2 <= self.stream_k_max_slices <= 10:
+            raise ValueError("stream_k_max_slices must be an integer between 2 and 10")
         for name in ("producer_stage_unroll", "consumer_stage_unroll"):
             value = getattr(self, name)
             if value is not None and (type(value) is not int or value < 1):
diff --git a/humming/include/humming/scheduler.cuh b/humming/include/humming/scheduler.cuh
index fc1b820cce4b7f139bdacfca5b06c717bcc1e4aa..22f00c80b70ff1041d9fdb2657be702ac53f8d84 100644
--- a/humming/include/humming/scheduler.cuh
+++ b/humming/include/humming/scheduler.cuh
@@ -121,7 +121,11 @@ public:
 
       // A tile can start in the last iteration of a CTA's work interval.
       // Include that partial first slice when bounding the total slice count.
-      constexpr uint32_t kMaxSlices = 10;
+      // Selected Decode projections use at most three ordered BF16 slices.
+      // Preserve the upstream partition by default; the limit belongs to the
+      // compiled tuning configuration so graph capture uses the same contract.
+      constexpr uint32_t kMaxSlices = Ctx::TuningConfig::kStreamKMaxSlices;
+      static_assert(kMaxSlices >= 2 && kMaxSlices <= 10);
       constexpr uint32_t kMinSliceIters = CEIL_DIV(kStreamKBlocks - 1, kMaxSlices - 1);
       streamk_mnk_total_iters = MAX(streamk_mnk_total_iters, kMinSliceIters);
 
